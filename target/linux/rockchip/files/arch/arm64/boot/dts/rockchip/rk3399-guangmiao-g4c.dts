/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "rk3399.dtsi"
#include "rk3399-opp.dtsi"

/ {
	model = "Huake-Cloud GuangMiao G4C";
	compatible = "huake,guangmiao-g4c", "rockchip,rk3399";

	aliases {
		ethernet0 = &gmac;
		mmc0 = &sdmmc;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	reboot-mode {
		compatible = "rockchip,reboot-mode";
		syscon = <&pmugrf>;
		mode-normal = <0x00000000>;
		mode-reboot = <0x00000001>;
		mode-loader = <0x00000003>;
	};

	/* 以下 100% 来自你原厂 full-rk3399.txt，无任何修改 */
	vcc3v3_sys: vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
		gpio = <&gpio4 RK_PD5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vcc1v8_s3: vcc1v8-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8_s3";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc3v0_sd: vcc3v0-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v0_sd";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		gpio = <&gpio0 RK_PA1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	vbus_typec: vbus-typec {
		compatible = "regulator-fixed";
		regulator-name = "vbus_typec";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vdd_5v: vdd-5v {
		compatible = "regulator-fixed";
		regulator-name = "vdd_5v";
		regulator-always-on;
		regulator-boot-on;
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm1 0 3500 PWM_POLARITY_INVERTED>;
		cooling-levels = <0 12 18 255>;
		fan-supply = <&vdd_5v>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = "default";
		autorepeat;

		button-restart {
			label = "reset";
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			wakeup-source;
			debounce-interval = <60>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		status_led: led-status {
			label = "status";
			color = <LED_COLOR_ID_GREEN>;
			function = <LED_FUNCTION_STATUS>;
			gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};

		lan_led: led-lan {
			label = "lan";
			color = <LED_COLOR_ID_GREEN>;
			function = <LED_FUNCTION_LAN>;
			gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		};

		wan_led: led-wan {
			label = "wan";
			color = <LED_COLOR_ID_GREEN>;
			function = <LED_FUNCTION_WAN>;
			gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk808 1>;
		clock-names = "ext_clock";
		reset-gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
	};
};

&gmac {
	status = "okay";
	phy-mode = "rgmii";
	tx-delay = <40>;
	rx-delay = <17>;
	assigned-clocks = <&cru SCLK_RMII_SRC>;
	assigned-clock-parents = <&clk_125m>;
};

&pcie0 {
	status = "okay";
	max-link-speed = <1>;
	num-lanes = <1>;
};

&sdmmc {
	status = "okay";
	bus-width = <4>;
	cap-sd-highspeed;
	cap-mmc-highspeed;
	cd-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_LOW>;
	disable-wp;
	vmmc-supply = <&vcc3v0_sd>;
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	rk808: pmic@1b {
		reg = <0x1b>;
		clocks = <&xin32k>;
		clock-frequency = <32768>;
		#clock-cells = <1>;
	};
};

&uart0 { status = "okay"; };
&uart2 { status = "okay"; };
&pwm1  { status = "okay"; };

&usb_host0_ehci { status = "okay"; };
&usb_host0_ohci { status = "okay"; };
&usb_host1_ehci { status = "okay"; };
&usb_host1_ohci { status = "okay"; };
&usbdrd3_0    { status = "okay"; };
&usbdrd3_1    { status = "okay"; };

&gpu  { status = "okay"; };
&vpu  { status = "okay"; };
&rga  { status = "okay"; };

&cdn_dp  { status = "disabled"; };
&hdmi    { status = "disabled"; };
&mipi_dsi{ status = "disabled"; };
&edp     { status = "disabled"; };

&i2s0  { status = "disabled"; };
&i2s1  { status = "disabled"; };
&spdif { status = "disabled"; };
&spi0  { status = "disabled"; };
&spi1  { status = "disabled"; };
&uart1 { status = "disabled"; };
&uart3 { status = "disabled"; };
&uart4 { status = "disabled"; };
