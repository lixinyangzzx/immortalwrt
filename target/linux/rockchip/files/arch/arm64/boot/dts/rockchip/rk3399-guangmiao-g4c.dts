// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "rk3399.dtsi"
#include "rk3399-opp.dtsi"

/ {
	model = "Huake-Cloud GuangMiao G4C";
	compatible = "huake,guangmiao-g4c", "rockchip,rk3399";
	serial-number = "5a3afcbc099c13a8";

	/* 软重启配置，沿用原机 reboot-mode 寄存器逻辑 */
	reboot-mode {
		compatible = "syscon-reboot-mode";
		syscon = <&pmugrf>;
		offset = <0x300>;
		mode-normal = <0x5242c300>;
		mode-reboot = <0x5242c301>;
		mode-loader = <0x5242c303>;
		mode-recovery = <0x5242c303>;
		mode-charge = <0x5242c30b>;
		status = "okay";
	};

	aliases {
		ethernet0 = &gmac;
		ethernet1 = &pcie_eth;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		mmc0 = &sdio0;
		mmc1 = &sdmmc;
		mmc2 = &sdhci;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		led-boot = &status_led;
		led-failsafe = &status_led;
		led-running = &status_led;
		led-upgrade = &status_led;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* 时钟: 24M 外部晶振 */
	xin24m: external-24m-clock {
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
		clock-output-names = "xin24m";
		#clock-cells = <0>;
	};

	/* 固定电源轨 (完全沿用原机配置) */
	vcc_sys: vcc-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc3v3_sys: vcc3v3-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_sys>;
	};

	vcc_0v9: vcc-0v9-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_0v9";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc5v0_host0: vcc5v0-host0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_sys>;
	};

	vdd_log: vdd-log-regulator {
		compatible = "pwm-regulator";
		pwms = <&pwm2 0 25000 1>;
		regulator-name = "vdd_log";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <1400000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc_sys>;
	};

	/* 按键 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&reset_button_pin>;
		autorepeat;

		button-reset {
			label = "reset";
			debounce-interval = <100>;
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	/* LED 指示灯 */
	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&lan_led_pin>, <&status_led_pin>, <&wan_led_pin>;

		status_led: led-status {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};

		lan_led: led-lan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;
		};

		wan_led: led-wan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&gpio0 RK_PB2 GPIO_ACTIVE_HIGH>;
		};
	};

	/* 关闭显示子系统 (原机配置) */
	/delete-node/ display-subsystem;
};

/* ========== CPU 供电 (原机电压/供电链路完整保留) ========== */
&cpu_b0 {
	cpu-supply = <&vdd_cpu_b>;
};
&cpu_b1 {
	cpu-supply = <&vdd_cpu_b>;
};
&cpu_l0 {
	cpu-supply = <&vdd_cpu_l>;
};
&cpu_l1 {
	cpu-supply = <&vdd_cpu_l>;
};
&cpu_l2 {
	cpu-supply = <&vdd_cpu_l>;
};
&cpu_l3 {
	cpu-supply = <&vdd_cpu_l>;
};

/* ========== GMAC 千兆网口 (原机MAC、延时、PHY、中断完全沿用) ========== */
&gmac {
	local-mac-address = [ca 4f c5 f0 d3 df];
	phy-mode = "rgmii";
	tx_delay = <0x28>;
	rx_delay = <0x11>;
	assigned-clocks = <&cru SCLK_RMII_SRC>;
	assigned-clock-parents = <&xin24m>;
	clock_in_out = "input";
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii_pins>, <&phy_intb>, <&phy_pmeb>, <&phy_rstb>;
	phy-handle = <&rtl8211e>;
	phy-supply = <&vcc3v3_s3>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		rtl8211e: ethernet-phy@1 {
			reg = <1>;
			interrupt-parent = <&gpio3>;
			interrupts = <RK_PB2 IRQ_TYPE_LEVEL_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <30000>;
			reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
		};
	};
};

/* ========== PCIe 及板载网卡 (原机配置) ========== */
&pcie0 {
	max-link-speed = <1>;
	num-lanes = <1>;
	ep-gpios = <&gpio4 RK_PD2 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie_clkreqnb_cpm>;
	vpcie0v9-supply = <&vcc_0v9>;
	vpcie1v8-supply = <&vcca_1v8>;
	vpcie3v3-supply = <&vcc3v3_sys>;
	status = "okay";

	pcie@0 {
		#address-cells = <3>;
		#size-cells = <2>;
		pcie_eth: pcie-eth@0,0 {
			reg = <0 0 0 0 0>;
			local-mac-address = [ca 4f 72 d8 b5 37];
		};
	};
};

&pcie_phy {
	assigned-clocks = <&cru SCLK_PCIEPHY_REF>;
	assigned-clock-parents = <&cru SCLK_PCIEPHY_REF100M>;
	assigned-clock-rates = <100000000>;
	status = "okay";
};

/* ========== I2C0 + 双路CPU/GPU稳压 + RK808 PMIC (原机完整电源树) ========== */
&i2c0 {
	clock-frequency = <400000>;
	i2c-scl-rising-time-ns = <160>;
	i2c-scl-falling-time-ns = <30>;
	status = "okay";

	/* CPU 大核供电 SYR827 */
	vdd_cpu_b: regulator@40 {
		compatible = "silergy,syr827";
		reg = <0x40>;
		fcs,suspend-voltage-selector = <1>;
		pinctrl-names = "default";
		pinctrl-0 = <&cpu_b_sleep>;
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1500000>;
		regulator-ramp-delay = <1000>;
		vin-supply = <&vcc_sys>;
		regulator-always-on;
		regulator-boot-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	/* GPU 供电 SYR828 */
	vdd_gpu: regulator@41 {
		compatible = "silergy,syr828";
		reg = <0x41>;
		fcs,suspend-voltage-selector = <1>;
		pinctrl-names = "default";
		pinctrl-0 = <&gpu_sleep>;
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1500000>;
		regulator-ramp-delay = <1000>;
		vin-supply = <&vcc_sys>;
		regulator-always-on;
		regulator-boot-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	/* RK808 完整LDO/DCDC 沿用原机所有电压、休眠配置 */
	rk808: pmic@1b {
		compatible = "rockchip,rk808";
		reg = <0x1b>;
		clock-output-names = "rtc_clko_soc", "rtc_clko_wifi";
		#clock-cells = <1>;
		interrupt-parent = <&gpio1>;
		interrupts = <21 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int_l>;
		rockchip,system-power-controller;
		wakeup-source;

		vcc1-supply = <&vcc_sys>;
		vcc2-supply = <&vcc_sys>;
		vcc3-supply = <&vcc_sys>;
		vcc4-supply = <&vcc_sys>;
		vcc6-supply = <&vcc_sys>;
		vcc7-supply = <&vcc_sys>;
		vcc8-supply = <&vcc_3v0>;
		vcc9-supply = <&vcc_sys>;
		vcc10-supply = <&vcc_sys>;
		vcc11-supply = <&vcc_sys>;
		vcc12-supply = <&vcc_sys>;
		vddio-supply = <&vcc_3v0>;

		regulators {
			vdd_center: DCDC_REG1 {
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vdd_cpu_l: DCDC_REG2 {
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};
			vcc_1v8: DCDC_REG4 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};
			vcc_vldo1: LDO_REG1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc_vldo2: LDO_REG2 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcca_1v8: LDO_REG3 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};
			vcc_sdio: LDO_REG4 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};
			vcc3v0_sd: LDO_REG5 {
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};
			vcc_1v5: LDO_REG6 {
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <1500000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1500000>;
				};
			};
			vcca1v8_codec: LDO_REG7 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc_3v0: LDO_REG8 {
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};
			vcc3v3_s3: SWITCH_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
			vcc3v3_s0: SWITCH_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

/* 其余I2C 沿用原机状态 */
&i2c1 { status = "okay"; };
&i2c2 {
	i2c-scl-rising-time-ns = <450>;
	i2c-scl-falling-time-ns = <15>;
	status = "okay";
};
&i2c3 { status = "disabled"; };
&i2c4 { status = "okay"; };
&i2c5 { status = "disabled"; };
&i2c6 { status = "disabled"; };
&i2c7 { status = "okay"; };
&i2c8 { status = "okay"; };

/* IO 电压域 (原机配置) */
&io_domains {
	bt656-supply = <&vcc_1v8>;
	audio-supply = <&vcca1v8_codec>;
	sdmmc-supply = <&vcc_sdio>;
	gpio1830-supply = <&vcc_3v0>;
	status = "okay";
};
&pmu_io_domains {
	pmu1830-supply = <&vcc_3v0>;
	status = "okay";
};

/* 引脚控制 (全部沿用原机pin定义) */
&pinctrl {
	gpio-leds {
		lan_led_pin: lan-led-pin { rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>; };
		status_led_pin: status-led-pin { rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>; };
		wan_led_pin: wan-led-pin { rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>; };
	};
	gmac {
		phy_intb: phy-intb { rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>; };
		phy_pmeb: phy-pmeb { rockchip,pins = <0 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>; };
		phy_rstb: phy-rstb { rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>; };
	};
	pmic {
		cpu_b_sleep: cpu-b-sleep { rockchip,pins = <1 RK_PC2 RK_FUNC_GPIO &pcfg_pull_down>; };
		gpu_sleep: gpu-sleep { rockchip,pins = <1 RK_PB6 RK_FUNC_GPIO &pcfg_pull_down>; };
		pmic_int_l: pmic-int-l { rockchip,pins = <1 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>; };
	};
	rockchip-key {
		reset_button_pin: reset-button { rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>; };
	};
	sdio {
		bt_reg_on_h: bt-reg-on-h { rockchip,pins = <0 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>; };
	};
	sdmmc {
		sdmmc0_det_l: sdmmc0-det-l { rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>; };
	};
	pcie {
		pcie_clkreqnb_cpm: pcie-clkreqnb-cpm { };
	};
};

/* PWM 配置 */
&pwm0 { status = "okay"; };
&pwm1 { status = "okay"; };
&pwm2 {
	pinctrl-names = "active";
	pinctrl-0 = <&pwm2_pin_pull_down>;
	status = "okay";
};

/* 温控、ADC (原机参数保留) */
&tsadc {
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <1>;
	status = "okay";
};
&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};
&thermal_zones {
	cpu {
		polling-delay-passive = <100>;
		polling-delay = <1000>;
		trips {
			cpu_w { temperature = <5500>; };
			cpu_h { temperature = <6500>; };
			cpu_alert0 { temperature = <7000>; };
			cpu_alert1 { temperature = <7500>; };
			cpu_crit { temperature = <9500>; };
		};
	};
	gpu {
		polling-delay-passive = <100>;
		polling-delay = <1000>;
		trips {
			gpu_alert0 { temperature = <7500>; };
			gpu_crit { temperature = <9500>; };
		};
	};
};

/* SD/EMMC 存储 (原机状态+参数) */
&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-mmc-highspeed;
	cd-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_LOW>;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_bus4 &sdmmc_clk &sdmmc_cmd &sdmmc0_det_l>;
	sd-uhs-sdr50;
	vqmmc-supply = <&vcc_sdio>;
	status = "okay";
};
&sdio0 { status = "disabled"; };
&sdhci {
	bus-width = <8>;
	mmc-hs200-1_8v;
	non-removable;
	status = "okay";
};
&emmc_phy { status = "okay"; };

/* USB 硬件 (原机全部启用) */
&u2phy0 { status = "okay"; };
&u2phy0_host { phy-supply = <&vcc5v0_host0>; status = "okay"; };
&u2phy0_otg { status = "okay"; };
&u2phy1 { status = "okay"; };
&u2phy1_host { phy-supply = <&vcc5v0_host0>; status = "okay"; };
&u2phy1_otg { status = "okay"; };
&tcphy0 { status = "okay"; };
&tcphy1 { status = "okay"; };

&usb_host0_ehci { status = "okay"; };
&usb_host0_ohci { status = "okay"; };
&usb_host1_ehci { status = "okay"; };
&usb_host1_ohci { status = "okay"; };
&usbdrd3_0 { status = "okay"; };
&usbdrd3_1 { status = "okay"; };
&usbdrd_dwc3_0 { dr_mode = "host"; status = "okay"; };
&usbdrd_dwc3_1 { dr_mode = "host"; status = "okay"; };

/* 多媒体 (GPU/编解码 原机启用) */
&gpu {
	mali-supply = <&vdd_gpu>;
	status = "okay";
};
&vpu { status = "okay"; };
&vdec { status = "okay"; };
&rga { status = "okay"; };

/* 显示类外设 (原机关闭) */
&vopb { status = "disabled"; };
&vopb_mmu { status = "disabled"; };
&vopl { status = "disabled"; };
&vopl_mmu { status = "disabled"; };
&cdn_dp { status = "disabled"; };
&hdmi { status = "disabled"; };
&mipi_dsi { status = "disabled"; };
&edp { status = "disabled"; };

/* 音频、SPI、多余串口 (原机禁用) */
&i2s0 { status = "disabled"; };
&i2s1 { status = "disabled"; };
&spdif { status = "disabled"; };
&spi0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&spi2 { status = "disabled"; };
&spi3 { status = "disabled"; };
&spi4 { status = "disabled"; };
&spi5 { status = "disabled"; };
&uart1 { status = "disabled"; };
&uart3 { status = "disabled"; };
&uart4 { status = "okay"; };
&uart0 { status = "okay"; };
&uart2 { status = "okay"; };
